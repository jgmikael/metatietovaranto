ryhti-akr:AlueidenkaytonRajoitus
        rdf:type                      sh:NodeShape;
        rdfs:comment                  "suoraan laista johtuva tai viranomaisen kaavassa, rakennusjärjestyksessä tai erillisellä päätöksellä antama rajoitus, joka koskee alueidenkäytön järjestämistä tietyllä alueella"@fi , "begränsning som direkt beror på lag eller som utfärdats av myndighet i plan, byggnadsordning eller separat beslut och som gäller ordnandet av områdesanvändningen på ett visst område "@sv;
        rdfs:isDefinedBy              ryhti-akr:;
        rdfs:label                    "Alueidenkäytön rajoitus"@fi , "Begränsning av områdesanvändningen"@sv , "Area use restriction"@en;
        dcterms:created               "2024-03-28T13:29:47.164Z";
        dcterms:identifier            "AlueidenkaytonRajoitus"^^xsd:NCName;
        dcterms:modified              "2025-12-02T10:28:39.196Z"^^xsd:dateTime;
        dcterms:subject               <https://iri.suomi.fi/terminology/rakymp/c498>;
        sh:property                   ryhti-akr:voimassaolonalkamispaivamaara , ryhti-akr:voimassaolonloppumispaivamaara-1 , ryhti-akr:alueidenkaytonrajoituksenavain , ryhti-akr:paatos , ryhti-akr:elinkaarentila-1 , ryhti-akr:hyvaksymispaivamaara , ryhti-akr:alueidenkaytonrajoituksenkohde-1;
        sh:targetClass                rak:AlueidenkaytonRajoitus;
        suomi-meta:modifier           "2090218f-2ef2-4c15-bab9-00ff65f5ad9d";
        suomi-meta:publicationStatus  <http://yti-fuseki-v4:3031/core/VALID> .

