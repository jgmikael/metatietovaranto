ryhti-akr:Toimija  rdf:type           sh:NodeShape;
        rdfs:comment                  "The Agent class aggregates information about attributes or characteristics of agents (persons, organizations or software). Agent information serves to identify an agent unambiguously from all other Agent entities.\n<br>\n• May hold or grant one or more rights.\n<br>\n• May carry out, authorize, or compel one or more events.\n<br>\n• May create or act upon one or more objects through an event or with respect to a rights\nstatement."@en , "Keskinäisessä toiminnassa mukana oleva aktiivinen osallinen, joka voidaan yksilöidä."@fi;
        rdfs:isDefinedBy              ryhti-akr:;
        rdfs:label                    "Operator"@en , "Aktör"@sv , "Toimija"@fi;
        dcterms:created               "2024-03-11T06:27:23.981Z";
        dcterms:identifier            "Toimija"^^xsd:NCName;
        dcterms:modified              "2024-04-05T12:53:05.791Z";
        dcterms:subject               <https://iri.suomi.fi/terminology/jhs/J231>;
        sh:property                   ryhti-akr:toimijaavain;
        sh:targetClass                rak:Toimija;
        suomi-meta:publicationStatus  <http://yti-fuseki-v4:3031/core/VALID> .

