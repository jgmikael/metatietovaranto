ryhti-akr:Organisaatio
        rdf:type                      sh:NodeShape;
        rdfs:comment                  "Organisaatiolla tarkoitetaan tiettyä toimintaa varten perustettua sosiaalista järjestelmää, jolla on määritellyt tavoitteet ja tarkoituksellisesti luotu rakenne. Organisaatio-luokka kattaa mm. kaikki yritysmuodot ja kaikki rekisteröidyt organisaatiot, jotka yleensä ovat oikeushenkilöitä, mutta myös löyhemmät ryhmittymät joilla ei ole virallista statusta."@fi , "a social system set up for a specific purpose/for a specific activity, which has defined objectives and a deliberately created structure"@en;
        rdfs:isDefinedBy              ryhti-akr:;
        rdfs:label                    "Organisaatio"@fi , "Organization"@en , "Organisation"@sv;
        dcterms:created               "2024-04-05T12:50:06.884Z";
        dcterms:identifier            "Organisaatio"^^xsd:NCName;
        dcterms:modified              "2025-12-02T10:16:39.888Z"^^xsd:dateTime;
        dcterms:subject               <https://iri.suomi.fi/terminology/jhs/J132>;
        sh:property                   ryhti-akr:uuid-53663115-2c01-491a-844f-68727581c79f , ryhti-akr:ytunnus , ryhti-akr:ylaluokka-2;
        sh:targetClass                rak:Organisaatio;
        suomi-meta:modifier           "2090218f-2ef2-4c15-bab9-00ff65f5ad9d";
        suomi-meta:publicationStatus  <http://yti-fuseki-v4:3031/core/VALID> .

ryhti-akr:  rdf:type                  owl:Ontology , suomi-meta:ApplicationProfile;
        rdfs:comment                  "Tietomalli, jonka mukaisesti voi laatia koneluettavia ja yhteentoimivia alueidenkäytön rajoituksia eli rakentamisrajoituksia, rakennuskieltoja, toimenpidekieltoja ja suunnittelutarvealueita. Tietomallia käytetään rakennetun ympäristön tietojärjestelmän alueidenkäytön tietovarannon rakentamisen pohjana."@fi;
        rdfs:label                    "Alueidenkäytön rajoitusten tietomalli"@fi , "Data model for restrictions on land use"@en , "Datamodell för begränsningar av områdesanvändningen"@sv;
        dcterms:contributor           <urn:uuid:85cd3d52-5b61-49be-ab18-c316bb5eb77f>;
        dcterms:created               "2024-03-11T05:16:29.979Z";
        dcterms:identifier            "187539ca-aed4-44eb-b859-cdb92f578c54";
        dcterms:isPartOf              <http://urn.fi/URN:NBN:fi:au:ptvl:v1007>;
        dcterms:language              "fi" , "sv" , "en";
