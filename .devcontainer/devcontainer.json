{
  "name": "Metatietovaranto verkkodemo",
  "dockerComposeFile": ["../compose.yaml", "compose.codespaces.yaml"],
  "service": "workspace",
  "runServices": ["db", "keycloak", "app", "workspace"],
  "workspaceFolder": "/workspaces/metatietovaranto",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Avaa Metatietovarannon demo",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "5432": {"onAutoForward": "ignore"}
  },
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "customizations": {
    "codespaces": {"openFiles": ["docs/verkkodemo.md"]}
  }
}
