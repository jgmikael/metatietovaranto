{
  "name": "metatietovaranto-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "build:help": "node scripts/build-help.mjs",
    "prebuild": "npm run build:help",
    "prebuild:pages": "npm run build:help",
    "test:help": "node --test tests/help.test.mjs",
    "predev": "npm run build:help"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "jsonld": "^9.0.0",
    "n3": "^2.13.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "~5.8.3",
    "unified": "^11.0.5",
    "vite": "^6.3.0"
  }
}
